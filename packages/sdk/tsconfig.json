{
  "compilerOptions": {
    "types": ["bun"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "bun"
    ]
  },
  "include": [
    "src"
  ]
}