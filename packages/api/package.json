{
  "name": "@hono-kiln/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./registry": "./registry.ts"
  },
  "scripts": {
    "audit": "knip",
    "typecheck": "tsc --noEmit",
    "sync-schema": "bun run scripts/sync-schema.ts",
    "dev": "bun --watch index.ts",
    "start": "bun index.ts",
    "test": "bun test",
    "db:migrate": "drizzle-kit generate",
    "db:squash": "bun run scripts/squash.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "bun db/seed.ts"
  },
  "dependencies": {
    "@hono-kiln/shared": "workspace:*",
    "@hono/swagger-ui": "0.6.1",
    "@hono/zod-openapi": "1.4.0",
    "@libsql/client": "^0.17.3",
    "@lucia-auth/adapter-drizzle": "1.1.0",
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.10.1",
    "inngest": "^4.11.0",
    "lucia": "3.2.2",
    "mysql2": "^3.22.6",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@hono-kiln/testing": "workspace:*",
    "@types/bun": "^1.3.14",
    "drizzle-kit": "0.31.10",
    "knip": "^6.27.0",
    "typescript": "^7.0.2"
  }
}
