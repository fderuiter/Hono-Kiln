import { OpenAPIHono, createRoute, z } from '@hono/zod-openapi'
import { HttpStatusCodes, InternalServerErrorSchema, UnauthorizedSchema, UnprocessableEntitySchema, ForbiddenSchema } from '@hono-kiln/shared'

import { {{serviceFnName}} } from './service'
import { {{schemaName}} } from './schema'
import type { AppEnv } from '../../env'
import { requirePermission } from '../../auth/guard'
{{#if isWorker}}import { inngest } from '../../inngest/client'
{{/endif}}
export const {{routeName}} = new OpenAPIHono<AppEnv>()

const listRoute = createRoute({
  method: 'get',
  path: '/',
  tags: ['{{pascalName}}'],
  summary: '{{primaryRouteSummary}}',
  description: '{{moduleDescription}}',
  responses: {
    [HttpStatusCodes.OK]: {
      description: 'Successful response',
      content: {
        'application/json': {
          schema: z.object({
            data: z.array({{schemaName}}).openapi({ description: 'List of {{pascalName}} objects' }),
          }).openapi('{{pascalName}}ListResponse'),
        },
      },
    },
    [HttpStatusCodes.UNAUTHORIZED]: {
      description: 'Unauthorized',
      content: {
        'application/json': {
          schema: UnauthorizedSchema,
        },
      },
    },
    [HttpStatusCodes.FORBIDDEN]: {
      description: 'Forbidden',
      content: {
        'application/json': {
          schema: ForbiddenSchema,
        },
      },
    },
    [HttpStatusCodes.UNPROCESSABLE_ENTITY]: {
      description: 'Validation Error',
      content: {
        'application/json': {
          schema: UnprocessableEntitySchema,
        },
      },
    },
    [HttpStatusCodes.INTERNAL_SERVER_ERROR]: {
      description: 'Internal Server Error',
      content: {
        'application/json': {
          schema: InternalServerErrorSchema,
        },
      },
    },
  },
})

/**
 * Authorization Guard: requirePermission
 * 
 * The `requirePermission` middleware intercepts requests and checks the user's scopes.
 * Ensure you have configured the '{{moduleName}}:read' and '{{moduleName}}:write'
 * permissions in your central user and permission systems.
 *
 * To make this endpoint public (e.g., for webhooks or public APIs):
 * 1. Remove the `requirePermission('...')` wrapper below.
 * 2. Directly pass the async handler to `{{routeName}}.openapi(listRoute, async (c) => { ... })`
 */
{{routeName}}.openapi(listRoute, requirePermission('{{moduleName}}:read')(async (c) => {
  const db = c.get('db')
  const service = {{serviceFnName}}(db)
{{#if isTenant}}  const orgId = c.get('organizationId')
  if (!orgId) {
    return c.json({ error: 'Unauthorized' }, HttpStatusCodes.UNAUTHORIZED as any)
  }
  return c.json({ data: await service.list(orgId) }, HttpStatusCodes.OK as any)
{{/endif}}{{#if notTenant}}
  return c.json(
    {
      data: service.list(),
    },
    HttpStatusCodes.OK as any,
  )
{{/endif}}}))
{{#if isWorker}}
const triggerRoute = createRoute({
  method: 'post',
  path: '/trigger',
  tags: ['{{pascalName}}'],
  summary: 'Trigger background worker',
  responses: {
    [HttpStatusCodes.OK]: {
      description: 'Worker triggered',
      content: {
        'application/json': { schema: z.object({ message: z.string() }) },
      },
    },
    [HttpStatusCodes.UNAUTHORIZED]: {
      description: 'Unauthorized',
      content: {
        'application/json': { schema: UnauthorizedSchema },
      },
    },
    [HttpStatusCodes.FORBIDDEN]: {
      description: 'Forbidden',
      content: {
        'application/json': { schema: ForbiddenSchema },
      },
    },
  }
})

/**
 * Authorization Guard: requirePermission (Worker Trigger)
 * Protects manual triggers for background jobs. You can swap '{{moduleName}}:write' 
 * for a system-level role if needed.
 */
{{routeName}}.openapi(triggerRoute, requirePermission('{{moduleName}}:write')(async (c) => {
  await inngest.send({ name: '{{moduleName}}/process', data: {} })
  return c.json({ message: 'Worker triggered successfully' }, HttpStatusCodes.OK as any)
}))
{{/endif}}
